# Port du pont scanner
PORT=3001

# Chemin vers NAPS2.Console.exe sur la machine du scanner
NAPS2_PATH=C:\Program Files\NAPS2\NAPS2.Console.exe

# Pilote : wia (Windows, recommande) ou twain
NAPS2_DRIVER=wia

# Nom exact du scanner (laisser vide = premier scanner detecte)
NAPS2_DEVICE=

# Dossier ou NAPS2 depose les fichiers scannes
SCAN_OUTPUT_DIR=./scans
